{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sentia Processed Data Contract v1.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "mentions",
    "insights",
    "knowledge",
    "statistics",
    "errors"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "processing_version",
        "rules_version",
        "run_id"
      ]
    },
    "mentions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mention"
      }
    },
    "insights": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/insight"
      }
    },
    "knowledge": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "canonical_name",
          "aliases",
          "frequency",
          "confidence",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "topic",
              "entity",
              "intent",
              "problem",
              "organization",
              "pattern"
            ]
          },
          "canonical_name": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "frequency": {
            "type": "integer",
            "minimum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "validated",
              "rejected",
              "learned"
            ]
          },
          "knowledge_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_mention_count": {
            "type": "integer",
            "minimum": 0
          },
          "evidence_conversation_count": {
            "type": "integer",
            "minimum": 0
          },
          "evidence_mention_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 100
          },
          "evidence_conversation_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 100
          },
          "learning_engine": {
            "type": "string",
            "minLength": 1
          },
          "learned_at": {
            "type": "string"
          },
          "rejection_reason": {
            "type": "string"
          }
        }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": true
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "conversations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conversation_id",
          "fuente",
          "turns",
          "participants",
          "turn_count",
          "sentiment_counts",
          "unattributed_turns"
        ],
        "properties": {
          "conversation_id": {
            "type": "string"
          },
          "fuente": {
            "type": "string"
          },
          "turns": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "turn_index",
                "mention_id",
                "speaker",
                "speaker_role"
              ],
              "properties": {
                "turn_index": {
                  "type": "integer"
                },
                "mention_id": {
                  "type": "string"
                },
                "speaker": {
                  "type": "string"
                },
                "speaker_role": {
                  "type": "string"
                }
              }
            }
          },
          "participants": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "speaker",
                "speaker_role",
                "turns",
                "sentiments"
              ],
              "properties": {
                "speaker": {
                  "type": "string"
                },
                "speaker_role": {
                  "type": "string"
                },
                "turns": {
                  "type": "integer"
                },
                "sentiments": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "turn_count": {
            "type": "integer"
          },
          "sentiment_counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "unattributed_turns": {
            "type": "integer"
          },
          "analysis": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "turn_count",
              "sentiment_counts",
              "sentiment_trajectory",
              "sentiment_trend",
              "first_score",
              "last_score",
              "score_global",
              "severidad_global",
              "friction_score",
              "resolution_score",
              "friction_hits",
              "resolution_hits",
              "negative_turns",
              "unattributed_turns",
              "analysis_language"
            ],
            "properties": {
              "turn_count": {
                "type": "integer"
              },
              "sentiment_counts": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              },
              "sentiment_trajectory": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "positivo",
                    "negativo",
                    "neutro"
                  ]
                }
              },
              "sentiment_trend": {
                "type": "string",
                "enum": [
                  "mejora",
                  "empeora",
                  "estable"
                ]
              },
              "first_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "last_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "score_global": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "severidad_global": {
                "type": "string",
                "enum": [
                  "baja",
                  "media",
                  "alta",
                  "critica"
                ]
              },
              "friction_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "resolution_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "friction_hits": {
                "type": "integer",
                "minimum": 0
              },
              "resolution_hits": {
                "type": "integer",
                "minimum": 0
              },
              "negative_turns": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "unattributed_turns": {
                "type": "integer",
                "minimum": 0
              },
              "analysis_language": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "mention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id_mencion",
        "hash_mencion",
        "fecha",
        "texto_original",
        "texto_limpio",
        "sentimiento_pysentimiento",
        "score_sentimiento",
        "confianza_sentimiento",
        "categoria",
        "score_matematico",
        "severidad",
        "calidad_dato",
        "es_duplicado",
        "tiene_error",
        "advertencias",
        "procesado_en",
        "version_procesamiento",
        "version_reglas",
        "version_schema"
      ],
      "properties": {
        "id_mencion": {
          "type": "string",
          "minLength": 1
        },
        "hash_mencion": {
          "type": "string",
          "minLength": 1
        },
        "fuente": {
          "type": "string"
        },
        "fecha": {
          "type": "string",
          "format": "date-time"
        },
        "texto_original": {
          "type": "string",
          "minLength": 1
        },
        "texto_limpio": {
          "type": "string",
          "minLength": 1
        },
        "sentimiento_pysentimiento": {
          "enum": [
            "positivo",
            "negativo",
            "neutro"
          ]
        },
        "score_sentimiento": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "confianza_sentimiento": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "entidad_detectada": {
          "type": [
            "string",
            "null"
          ]
        },
        "categoria": {
          "type": "string",
          "minLength": 1
        },
        "subcategoria": {
          "type": "string"
        },
        "regla_activada": {
          "type": "string"
        },
        "reglas_activadas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prioridad_regla": {
          "type": "integer",
          "minimum": 0
        },
        "factores_score": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "score_matematico": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "severidad": {
          "enum": [
            "baja",
            "media",
            "alta",
            "critica"
          ]
        },
        "calidad_dato": {
          "enum": [
            "alta",
            "media",
            "baja",
            "invalida"
          ]
        },
        "es_duplicado": {
          "type": "boolean"
        },
        "tiene_error": {
          "type": "boolean"
        },
        "advertencias": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "procesado_en": {
          "type": "string",
          "format": "date-time"
        },
        "version_procesamiento": {
          "type": "string"
        },
        "version_reglas": {
          "type": "string"
        },
        "version_schema": {
          "type": "string"
        },
        "texto_traducido": {
          "type": [
            "string",
            "null"
          ]
        },
        "idioma_origen": {
          "type": "string"
        },
        "idioma_analisis": {
          "type": "string"
        },
        "metodo_traduccion": {
          "type": "string"
        },
        "speaker": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string"
        },
        "turn_index": {
          "type": "integer",
          "minimum": 1
        },
        "speaker_role": {
          "type": "string"
        }
      }
    },
    "insight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id_insight",
        "tipo",
        "resumen"
      ],
      "properties": {
        "id_insight": {
          "type": "string",
          "minLength": 1
        },
        "tipo": {
          "type": "string"
        },
        "resumen": {
          "type": "string"
        },
        "hallazgos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "temas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nivel_confianza": {
          "type": "string"
        },
        "limitaciones": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
