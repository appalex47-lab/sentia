{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Social Listening processed data",
  "type":"object",
  "additionalProperties":false,
  "required":["metadata","mentions","insights","statistics","errors"],
  "properties":{
    "metadata":{"type":"object","additionalProperties":true,"required":["schema_version","processing_version","rules_version","run_id"]},
    "mentions":{"type":"array","items":{"$ref":"#/$defs/mention"}},
    "insights":{"type":"array","items":{"$ref":"#/$defs/insight"}},
    "statistics":{"type":"object","additionalProperties":true},
    "errors":{"type":"array","items":{"type":"object","additionalProperties":true}}
  },
  "$defs":{
    "mention":{
      "type":"object","additionalProperties":false,
      "required":["id_mencion","hash_mencion","fecha","texto_original","texto_limpio","sentimiento_pysentimiento","score_sentimiento","confianza_sentimiento","categoria","score_matematico","severidad","calidad_dato","es_duplicado","tiene_error","advertencias","procesado_en","version_procesamiento","version_reglas","version_schema"],
      "properties":{
        "id_mencion":{"type":"string","minLength":1},
        "hash_mencion":{"type":"string","minLength":1},
        "fuente":{"type":"string"},
        "fecha":{"type":"string","format":"date-time"},
        "texto_original":{"type":"string","minLength":1},
        "texto_limpio":{"type":"string","minLength":1},
        "sentimiento_pysentimiento":{"enum":["positivo","negativo","neutro"]},
        "score_sentimiento":{"type":"number","minimum":-1,"maximum":1},
        "confianza_sentimiento":{"type":"number","minimum":0,"maximum":1},
        "entidad_detectada":{"type":["string","null"]},
        "categoria":{"type":"string","minLength":1},
        "subcategoria":{"type":"string"},
        "regla_activada":{"type":"string"},
        "reglas_activadas":{"type":"array","items":{"type":"string"}},
        "prioridad_regla":{"type":"integer","minimum":0},
        "factores_score":{"type":"array","items":{"type":"object","additionalProperties":true}},
        "score_matematico":{"type":"number","minimum":0,"maximum":100},
        "severidad":{"enum":["baja","media","alta","critica"]},
        "calidad_dato":{"enum":["alta","media","baja","invalida"]},
        "es_duplicado":{"type":"boolean"},
        "tiene_error":{"type":"boolean"},
        "advertencias":{"type":"array","items":{"type":"string"}},
        "procesado_en":{"type":"string","format":"date-time"},
        "version_procesamiento":{"type":"string"},
        "version_reglas":{"type":"string"},
        "version_schema":{"type":"string"}
      }
    },
    "insight":{
      "type":"object","additionalProperties":false,
      "required":["id_insight","tipo","resumen"],
      "properties":{
        "id_insight":{"type":"string","minLength":1},
        "tipo":{"type":"string"},
        "resumen":{"type":"string"},
        "hallazgos":{"type":"array","items":{"type":"string"}},
        "temas":{"type":"array","items":{"type":"string"}},
        "nivel_confianza":{"type":"string"},
        "limitaciones":{"type":"array","items":{"type":"string"}}
      }
    }
  }
}
